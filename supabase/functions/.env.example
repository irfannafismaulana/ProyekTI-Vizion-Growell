# Salin menjadi supabase/functions/.env (lokal) — file .env diabaikan git.
# Cloud: npx supabase secrets set --env-file supabase/functions/.env

# PRD F6/F7 — NanoGPT (https://nano-gpt.com/api → API key)
NANOGPT_API_KEY=
# Opsional: model lain (harus mendukung gambar untuk foto makanan)
# NANOGPT_CHAT_MODEL=deepseek/deepseek-v4-flash-latest
# NANOGPT_VISION_MODEL=deepseek/deepseek-v4-flash-latest
# AI_CHAT_DAILY_LIMIT=40
# AI_PHOTO_DAILY_LIMIT=15

# PRD F8 — Firebase Cloud Messaging (isi JSON service account dalam satu baris)
FIREBASE_SERVICE_ACCOUNT=
# Rahasia untuk memanggil fungsi pengingat dari cron (string acak panjang)
CRON_SECRET=
